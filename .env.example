# Copy to .env.local for development. In production set these in Vercel → Project → Settings → Environment Variables.
# Everything is server-only except the two NEXT_PUBLIC_SUPABASE_* values, which are public by design.

# PostgreSQL (Supabase). Transaction pooler, port 6543. Use the zenith_app role (supabase/setup/app_role.sql).
DATABASE_URL=
# Optional: session pooler or direct connection (port 5432) so live console updates use LISTEN/NOTIFY.
DATABASE_LISTEN_URL=
# 32+ random characters. Signs form tokens and keys IP hashes. `openssl rand -base64 48`
APP_SECRET=
# The production root domain. Subdomain routing only activates on this domain.
ROOT_DOMAIN=zenithesports.pk

# Sign-in (Supabase Auth, Google + email). Use a sign-in-only Supabase project — see docs/AUTH_SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: cookie domain for sign-in (defaults to .ROOT_DOMAIN in production).
# AUTH_COOKIE_DOMAIN=
# Allow staff to link a console account through email/password sign-in (default: Google only).
# Only set this if "Confirm email" is ON in the Supabase sign-in project.
# STAFF_EMAIL_LINKING=1
# Emergency/local only: allow console passwords even when Supabase is configured.
# STAFF_PASSWORD_LOGIN=1

# Optional integrations — when unset, notifications are recorded as "skipped", never faked.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
DISCORD_WEBHOOK_URL=

# Local development with `npm run db:local` (PGlite: one session, no cross-connection NOTIFY):
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# DATABASE_POOL_MAX=1
# REALTIME_LISTEN=off
# LOCAL_DEV_AUTH=1   # test sign-in without Supabase; refused unless the database is on this machine
