# Copy to .env.local for development. In production set these in Vercel → Project → Settings → Environment Variables.
# Server-only. None of these are exposed to the browser (there are no NEXT_PUBLIC_ variables).

# PostgreSQL (Supabase). Transaction pooler, port 6543. Use the zenith_app role (supabase/setup/app_role.sql).
DATABASE_URL=
# Optional: session pooler or direct connection (port 5432) so live console updates use LISTEN/NOTIFY.
DATABASE_LISTEN_URL=
# 32+ random characters. Signs form tokens and keys IP hashes. `openssl rand -base64 48`
APP_SECRET=
# The production root domain. Subdomain routing only activates on this domain.
ROOT_DOMAIN=zenithesports.pk

# Optional integrations — when unset, notifications are recorded as "skipped", never faked.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
DISCORD_WEBHOOK_URL=

# Local development with `npm run db:local` (PGlite: one session, no cross-connection NOTIFY):
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# DATABASE_POOL_MAX=1
# REALTIME_LISTEN=off
